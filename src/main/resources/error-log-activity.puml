
@startuml
skinparam style strictuml
title Activity: log_error file write flow

start

:'mode' := std::ios_base::app;
:log_file.open(log_file_name, mode);

if (log_file.is_open() ?) then (yes)
  :message := "[" + get_current_date_time() + "] ERROR: " + error_message + "\n";
  :log_file.write(message);
  :log_file.close();
else (no)
  :std::cerr << "Error: unable to open " + log_file_name + "!" << std::endl;
endif

stop
@enduml

@startuml
skinparam style strictuml

start
:Input: candidate (std::string_view);

if (candidate.empty?) then (yes)
  :construct stream_file_writer;
  :log_error("error.log", writer,\n "Invalid argument: password must not be empty");
  end
else (no)
endif

if (candidate.size < 3) then (yes)
  :construct stream_file_writer;
  :log_error("error.log", writer,\n "Invalid argument: password length must be at least 3 characters");
  end
else (no)
endif

:has_alpha = false;\nhas_digit = false;\nhas_special = false;

repeat
  :for each ch in candidate;

  if (isalpha(ch)) then (yes)
    :has_alpha = true;
  elseif (isdigit(ch)) then (yes)
    :has_digit = true;
  elseif (!isalnum(ch)) then (yes)
    :has_special = true;
  else
    :no category change;
  endif

repeat while ( !(has_alpha && has_digit && has_special) ) is (more chars?)

if (!has_alpha) then (yes)
  :construct stream_file_writer;
  :log_error("error.log", writer,\n "Invalid argument: password must contain at least one letter");
  end
else (no)
endif

if (!has_digit) then (yes)
  :construct stream_file_writer;
  :log_error("error.log", writer,\n "Invalid argument: password must contain at least one digit");
  end
else (no)
endif

if (!has_special) then (yes)
  :construct stream_file_writer;
  :log_error("error.log", writer,\n "Invalid argument: password must contain at least one special (non-alphanumeric) character");
  end
else (no)
endif

:Validation success (no exception thrown);
stop

@enduml

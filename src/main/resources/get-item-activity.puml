
@startuml
title Activity Diagram: safe_deposit_box<object>::get_item() const

start

:'get_item()' called;

if ("is_locked_ ?") then (yes)
  :Create stream_file_writer file_writer;
  :log_error("error.log", file_writer,\n  "Logic error: Attempt to place item in locked safe deposit box.");
  :throw std::logic_error(\n  "Attempt to access item from locked safe deposit box");
  end
else (no)
  :Call plain_box<object>::get_item();
  :return the retrieved object;
  stop
endif

@enduml


@startuml
skinparam style strictuml

'==========================
' Templated Classes
'==========================

package csc232 <<Folder>> {

    '----------------------
    ' box<object>
    '----------------------
    class "box<object>" as Box <<interface>> {
        {abstract} + set_item(item : object) : void
        {abstract} + get_item() : object
        + {virtual} ~box()
    }

    '----------------------
    ' plain_box<object>
    '----------------------
    class "plain_box<object>" as PlainBox {
        - item : object

        + plain_box()
        + plain_box(initial_item : object)
        + set_item(an_item : object) : void
        + get_item() : object
    }

    Box <|.. PlainBox : implements

    '----------------------
    ' safe_deposit_box<object>
    '----------------------
    class "safe_deposit_box<object>" as SafeDepositBox {
        - password_ : std::string
        - is_locked_ : bool
        - num_failures_ : std::size_t

        + safe_deposit_box(password : std::string)
        + {virtual} ~safe_deposit_box()
        + lock() : void
        + unlock(attempt : std::string_view) : bool
        + is_locked() : bool
        + get_item() : object
        + set_item(item : object) : void

        -- private static helpers --
        {static} - validate_password(candidate : std::string_view) : void
        {static} - validate_and_move(candidate : std::string) : std::string
    }

    PlainBox <|-- SafeDepositBox : extends
}

'==========================
' File Writer Classes
'==========================

package csc232 <<Folder>> {

    '----------------------
    ' file_writer interface
    '----------------------
    class file_writer <<interface>> {
        + {virtual} ~file_writer()
        {abstract} + open(filename : std::string, mode : ios_base::openmode)
        {abstract} + write(data : std::string)
        {abstract} + close()
        {abstract} + is_open() : bool
    }

    '----------------------
    ' stream_file_writer
    '----------------------
    class stream_file_writer <<final>> {
        - file_stream_ : std::ofstream

        + open(filename : std::string, mode : ios_base::openmode) : void
        + write(data : std::string) : void
        + close() : void
        + is_open() : bool
    }

    file_writer <|.. stream_file_writer : implements
}

@enduml
